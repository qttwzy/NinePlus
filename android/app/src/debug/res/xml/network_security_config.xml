<?xml version="1.0" encoding="utf-8"?>
<!-- Debug/personal builds: allow cleartext to private LAN for local NinePlus Platform. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
